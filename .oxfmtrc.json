{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "sortPackageJson": false,
  "associations": [
    {
      "files": ["*.html"],
      "language": "angular-html"
    }
  ],
  "ignorePatterns": ["libs/catalog", "CHANGELOG.md", "package-lock.json", "*.md"]
}
