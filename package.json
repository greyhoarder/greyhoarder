{
  "name": "greyhoarder",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "npm": ">=12"
  },
  "workspaces": [
    "libs/*",
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "start": "npm run start -w @greyhoarder/client",
    "start:server": "npm run build -w @greyhoarder/domain -w @greyhoarder/protocol && npm run start:dev -w @greyhoarder/server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "e2e": "npm run e2e -w @greyhoarder/e2e",
    "check:specs": "node scripts/checks/component-specs.mjs",
    "check:changed": "node scripts/checks/sensors.mjs",
    "release": "release-it"
  },
  "overrides": {
    "@nestjs/common": "^12.0.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "release-it": "^21.1.1"
  }
}
